# Copy to .streamlit/secrets.toml (git-ignored) and fill in only what you use.
# Environment variables with the same names take precedence.

STAFF_LANGUAGE = "en"            # default staff language code

TRANSLATION_PROVIDER = "mock"    # "mock" | "anthropic"
STT_PROVIDER = "mock"            # "mock" | "openai"
TTS_PROVIDER = "off"             # "off" | "gtts" | "openai"

# ANTHROPIC_API_KEY = "sk-ant-..."   # or use `ant auth login`
# ANTHROPIC_MODEL = "claude-opus-5-5"
# OPENAI_API_KEY = "sk-..."          # for STT_PROVIDER/TTS_PROVIDER = "openai"

PROFILE_TTL_HOURS = 12
