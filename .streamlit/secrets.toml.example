# Copy to .streamlit/secrets.toml (git-ignored) and fill in only what you use.
# Environment variables with the same names take precedence.

STAFF_LANGUAGE = "en"            # default staff language code

TRANSLATION_PROVIDER = "mock"    # "mock" | "duke"
STT_PROVIDER = "mock"            # "mock" | "duke"
TTS_PROVIDER = "off"             # "off" | "duke" | "gtts"

# Duke AI Gateway (LiteLLM, OpenAI-compatible)
# LITELLM_TOKEN = "..."
# LITELLM_BASE_URL = "https://litellm.oit.duke.edu/v1"
# Model names must match the gateway's model list (GET /v1/models).
# TRANSLATION_MODEL = "GPT 4.1"
# STT_MODEL = "whisper-1"
# TTS_MODEL = "tts-1"
# TTS_VOICE = "alloy"

PROFILE_TTL_HOURS = 12
