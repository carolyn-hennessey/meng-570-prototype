# Copy to .streamlit/secrets.toml (git-ignored) and fill in only what you use.
# Environment variables with the same names take precedence.

STAFF_LANGUAGE = "en"            # default staff language code

TRANSLATION_PROVIDER = "mock"    # "mock" | "nvidia"
STT_PROVIDER = "mock"            # "mock" | "nvidia"
TTS_PROVIDER = "off"             # "off" | "gtts"

# NVIDIA hosted API (OpenAI-compatible)
# NVIDIA_API_KEY = "nvapi-..."
# NVIDIA_BASE_URL = "https://integrate.api.nvidia.com/v1"
# TRANSLATION_MODEL = "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
# STT_MODEL = "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
# REASONING_BUDGET = 1024

PROFILE_TTL_HOURS = 12
